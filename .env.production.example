APP_NAME="Luma Daya"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database
DB_USERNAME=user_database
DB_PASSWORD=password_database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
PUBLIC_DISK_ROOT=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.domain-anda.com
MAIL_PORT=587
MAIL_USERNAME=email@domain-anda.com
MAIL_PASSWORD=password_email
MAIL_FROM_ADDRESS="email@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NAME="Admin Luma Daya"
ADMIN_EMAIL=admin@lumadaya.id
ADMIN_PASSWORD=ganti-password-admin-ini

VITE_APP_NAME="${APP_NAME}"
